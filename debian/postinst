#!/bin/sh
set -e

mkdir -p /var/lib/helium-multi-gateway/keys 2>/dev/null || true
systemctl daemon-reload

# Start (or restart) each helium-multi-gateway@<region> instance the
# operator has enabled. We detect these via the wants/ symlinks in /etc/
# rather than `systemctl list-units --state=active`, because prerm just
# stopped active instances and they'd no longer show as active here.
# Symlinks under /etc/systemd/system/multi-user.target.wants/ persist
# across dpkg cycles, so they're the durable source of truth for "which
# regions does the operator want running".
for link in /etc/systemd/system/multi-user.target.wants/helium-multi-gateway@*.service; do
  [ -e "$link" ] || continue
  systemctl restart "$(basename "$link")" || true
done
